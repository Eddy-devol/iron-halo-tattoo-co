generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum BookingStatus {
  PENDING
  REVIEWING
  NEEDS_INFORMATION
  APPROVED
  DECLINED
  BOOKED
  COMPLETED
  CANCELLED
}

enum BookingIdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DepositStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentPlanStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentSource {
  MANUAL
}

enum ConsentStatus {
  NOT_COMPLETED
  COMPLETED
}

model User {
  id                String                @id @default(uuid()) @db.Uuid
  email             String                @unique
  name              String?
  passwordHash      String?
  role              UserRole              @default(ADMIN)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  notes             BookingNote[]
  auditLogs         AuditLog[]
  sessions          Session[]
  recordedPayments  Payment[]             @relation("PaymentRecordedBy")
  verifiedConsents  TattooConsentRecord[] @relation("ConsentVerifiedBy")
  completedConsents TattooConsentRecord[] @relation("ConsentCompletedBy")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BookingRequest {
  id                 String                    @id @default(uuid()) @db.Uuid
  referenceNumber    String                    @unique
  fullName           String
  email              String
  phone              String?
  description        String
  style              String?
  placement          String
  size               String
  colorPreference    String?
  preferredTimeframe String?
  budget             String?
  additionalNotes    String?
  idempotencyKey     String?                   @unique
  idempotencyHash    String?
  idempotencyStatus  BookingIdempotencyStatus?
  status             BookingStatus             @default(PENDING)
  artistName         String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  referenceImages    BookingReferenceImage[]
  notes              BookingNote[]
  appointments       Appointment[]
  paymentPlan        PaymentPlan?
  consentRecord      TattooConsentRecord?

  @@index([status, createdAt])
  @@index([email])
}

model BookingReferenceImage {
  id               String         @id @default(uuid()) @db.Uuid
  bookingRequestId String         @db.Uuid
  storageKey       String         @unique
  originalFilename String
  mimeType         String
  fileSize         Int
  createdAt        DateTime       @default(now())
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  @@index([bookingRequestId])
}

model BookingNote {
  id               String         @id @default(uuid()) @db.Uuid
  bookingRequestId String         @db.Uuid
  authorId         String         @db.Uuid
  body             String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  author           User           @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([bookingRequestId, createdAt])
}

model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  bookingRequestId String            @db.Uuid
  startAt          DateTime
  endAt            DateTime
  status           AppointmentStatus @default(PENDING)
  depositStatus    DepositStatus     @default(NOT_REQUIRED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookingRequest   BookingRequest    @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  @@index([bookingRequestId])
  @@index([startAt, status])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model ArchiveArtwork {
  id           String        @id @default(uuid()) @db.Uuid
  title        String
  slug         String        @unique
  description  String?
  style        String?
  altText      String
  storageKey   String        @unique
  contentType  String
  featured     Boolean       @default(false)
  published    Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@index([published])
  @@index([featured])
  @@index([sortOrder])
  @@index([createdAt])
}

model PaymentPlan {
  id               String               @id @default(uuid()) @db.Uuid
  bookingRequestId String               @unique @db.Uuid
  totalAmount      Decimal              @db.Decimal(12, 2)
  currency         String               @db.VarChar(3)
  status           PaymentPlanStatus    @default(PENDING)
  installmentCount Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  bookingRequest   BookingRequest       @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  installments     PaymentInstallment[]
  payments         Payment[]

  @@index([status, createdAt])
}

model PaymentInstallment {
  id                String      @id @default(uuid()) @db.Uuid
  paymentPlanId     String      @db.Uuid
  installmentNumber Int
  dueDate           DateTime    @db.Date
  amount            Decimal     @db.Decimal(12, 2)
  paymentPlan       PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@unique([paymentPlanId, installmentNumber])
  @@index([dueDate])
}

model Payment {
  id            String             @id @default(uuid()) @db.Uuid
  paymentPlanId String             @db.Uuid
  installmentId String             @db.Uuid
  recordedById  String             @db.Uuid
  receiptNumber String             @unique
  amount        Decimal            @db.Decimal(12, 2)
  balanceAfter  Decimal            @db.Decimal(12, 2)
  currency      String             @db.VarChar(3)
  method        PaymentMethod
  source        PaymentSource      @default(MANUAL)
  paidAt        DateTime
  reference     String?
  notes         String?
  createdAt     DateTime           @default(now())
  paymentPlan   PaymentPlan        @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  installment   PaymentInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  recordedBy    User               @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([paymentPlanId, paidAt])
  @@index([installmentId, paidAt])
}

model TattooConsentRecord {
  id                       String         @id @default(uuid()) @db.Uuid
  bookingRequestId         String         @unique @db.Uuid
  legalName                String?
  dateOfBirth              DateTime?      @db.Date
  addressLine1             String?
  city                     String?
  state                    String?
  postalCode               String?
  governmentIdType         String?
  governmentIdLastFour     String?        @db.VarChar(4)
  identificationVerifiedAt DateTime?
  verifiedById             String?        @db.Uuid
  status                   ConsentStatus  @default(NOT_COMPLETED)
  completedAt              DateTime?
  completedById            String?        @db.Uuid
  consentTextSnapshot      String?        @db.Text
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  bookingRequest           BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  verifiedBy               User?          @relation("ConsentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  completedBy              User?          @relation("ConsentCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
}
