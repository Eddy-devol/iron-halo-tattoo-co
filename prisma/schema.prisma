generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum BookingStatus {
  PENDING
  REVIEWING
  NEEDS_INFORMATION
  APPROVED
  DECLINED
  BOOKED
  COMPLETED
  CANCELLED
}

enum BookingIdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DepositStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED
  FAILED
}

model User {
  id          String        @id @default(uuid()) @db.Uuid
  email       String        @unique
  name        String?
  passwordHash String?
  role        UserRole      @default(ADMIN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  notes       BookingNote[]
  auditLogs   AuditLog[]
  sessions    Session[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BookingRequest {
  id                   String                   @id @default(uuid()) @db.Uuid
  referenceNumber      String                   @unique
  fullName             String
  email                String
  phone                String?
  description          String
  style                String?
  placement            String
  size                 String
  colorPreference      String?
  preferredTimeframe   String?
  budget               String?
  additionalNotes      String?
  idempotencyKey        String?                  @unique
  idempotencyHash       String?
  idempotencyStatus     BookingIdempotencyStatus?
  status               BookingStatus            @default(PENDING)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  referenceImages      BookingReferenceImage[]
  notes                BookingNote[]
  appointments         Appointment[]

  @@index([status, createdAt])
  @@index([email])
}

model BookingReferenceImage {
  id                String         @id @default(uuid()) @db.Uuid
  bookingRequestId  String         @db.Uuid
  storageKey        String         @unique
  originalFilename  String
  mimeType          String
  fileSize          Int
  createdAt         DateTime       @default(now())
  bookingRequest    BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  @@index([bookingRequestId])
}

model BookingNote {
  id                String         @id @default(uuid()) @db.Uuid
  bookingRequestId  String         @db.Uuid
  authorId          String         @db.Uuid
  body              String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  bookingRequest    BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  author            User           @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([bookingRequestId, createdAt])
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  bookingRequestId  String            @db.Uuid
  startAt           DateTime
  endAt             DateTime
  status            AppointmentStatus @default(PENDING)
  depositStatus     DepositStatus     @default(NOT_REQUIRED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bookingRequest    BookingRequest    @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  @@index([bookingRequestId])
  @@index([startAt, status])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}