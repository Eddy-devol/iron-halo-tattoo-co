# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public studio contact details; rendered only when valid and configured.
STUDIO_CONTACT_EMAIL=
STUDIO_CONTACT_PHONE=
STUDIO_FACEBOOK_URL=

# PostgreSQL used by Prisma
DATABASE_URL=

# Development seed only; set a unique value of at least 12 characters in the shell.
DEV_ADMIN_PASSWORD=

# Private S3-compatible object storage (server-only)
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false

# Transactional email (server-only)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_REPLY_TO=

# Distributed rate limiting (required in production; optional in development)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set true only when the hosting proxy sanitizes and supplies these headers.
TRUST_PROXY_HEADERS=false
