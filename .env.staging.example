# Template only: copy to an ignored local file such as .env.staging.local.
# Configure each value with resources positively confirmed to belong to staging.
# Do not copy production credentials or use this file as a deployment secret store.

# Dedicated staging PostgreSQL database; never point this to production.
DATABASE_URL=

# Exact HTTPS origin of the staging deployment.
NEXT_PUBLIC_SITE_URL=

# Dedicated private staging bucket and least-privilege credentials.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Staging/test sender and explicitly controlled test recipients only.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_REPLY_TO=

# Dedicated staging Redis database only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Keep false unless the actual staging proxy is proven to overwrite these headers.
TRUST_PROXY_HEADERS=false

# Development-seed only. Leave unset in staging; create a staging admin through
# the secure admin bootstrap process with a unique temporary password.
DEV_ADMIN_PASSWORD=
